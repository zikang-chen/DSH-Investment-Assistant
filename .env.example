# 环境变量示例（复制为 .env 或直接在 shell 里导出）
# 不要把 .env 提交到仓库；本文件只列变量名与用途。

# ---- 可选：MCP 外部数据源 ----
# 妙想数据（东方财富）API Key
EM_API_KEY=
# 盈米（StarGate）API Key（需全局安装 yingmi-skill-cli）
YINGMI_API_KEY=

# ---- 可选：美国国会申报备用源 ----
DISCLOSED_CAPITOL_API_KEY=

# ---- 可选：SEC EDGAR 合规 User-Agent ----
# 格式：应用名 + 空格 + 维护者邮箱（EDGAR 要求可联系邮箱；未配置会阻止 EDGAR 请求）
DSH_SEC_EDGAR_UA=my-app contact@example.com

# ---- 可选：政策抓取 User-Agent 追加信息 ----
DSH_POLICY_UA=

# ---- 可选：WeStock CLI（腾讯自选股）路径 ----
# 未设置时自动探测：<repo>/.dsh-home/bin/westock → ~/.westock/bin/westock → PATH
WESTOCK_BIN=
